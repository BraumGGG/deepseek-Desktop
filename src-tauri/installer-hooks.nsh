!macro NSIS_HOOK_PREINSTALL
  ExecWait 'taskkill.exe /F /IM "deepseek-harness-desktop.exe"' $0
  ExecWait 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand ' $1
  Sleep 2000
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  ExecWait 'taskkill.exe /F /IM "deepseek-harness-desktop.exe"' $0
  ExecWait 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand ' $1
  Sleep 2000
!macroend
